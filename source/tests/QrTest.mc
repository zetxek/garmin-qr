import Toybox.Lang;
import Toybox.Test;

//! QR encoder tests.
//!
//! The expected matrices were dumped from github.com/skip2/go-qrcode -- the library the
//! server-side generator uses -- at error-correction level M, with the quiet zone stripped.
//! The whole pipeline is checked: bitstream, padding, Reed-Solomon, block interleaving,
//! function patterns, data placement and format bits. A single wrong bit anywhere changes the
//! matrix. The cases span one block (v1-v3), four blocks in one group (v6) and two block
//! groups of differing size (v8).
//!
//! Every payload is lowercase and digit-free on purpose. go-qrcode splits its input into
//! optimal segments and will switch to numeric mode for a run like "1234567890"; this encoder
//! is byte mode throughout, so a payload with a digit run produces a different -- equally
//! valid, slightly larger -- symbol and is not comparable.
//!
//! The mask is forced per case rather than chosen, because mask selection is the one place the
//! two deliberately differ. See qrChoosesALegalMask.
(:test)
function qrMatchesTheReferenceEncoder(logger as Test.Logger) as Boolean {
    // version 1
    TestSupport.assertQrMatches(logger, "hello", 2, [
            "111111100000001111111",
            "100000100101101000001",
            "101110101011101011101",
            "101110101010101011101",
            "101110101010101011101",
            "100000101001001000001",
            "111111101010101111111",
            "000000001010000000000",
            "101111100011001111100",
            "111010010011111001101",
            "011010100000101101110",
            "000011010001111001100",
            "010100111100100100001",
            "000000001110100101001",
            "111111100101010010110",
            "100000101010000111110",
            "101110101101010010010",
            "101110101101111101000",
            "101110101000101100100",
            "100000100101111011100",
            "111111101000100010010"
        ]);
    // version 1
    TestSupport.assertQrMatches(logger, "a", 5, [
            "111111100101101111111",
            "100000101011001000001",
            "101110101101001011101",
            "101110101011001011101",
            "101110100100101011101",
            "100000100011001000001",
            "111111101010101111111",
            "000000001100000000000",
            "100000101011011001110",
            "100110000001110111001",
            "001011100110101100000",
            "010101011001111101010",
            "110100111101111111111",
            "000000001100100000101",
            "111111100111010011110",
            "100000100010001000111",
            "101110100111010011100",
            "101110100101111101000",
            "101110100101110111011",
            "100000100011111101000",
            "111111101010100100110"
        ]);
    // version 2
    TestSupport.assertQrMatches(logger, "Wi-Fi password: hunter", 6, [
            "1111111010000100001111111",
            "1000001010110100001000001",
            "1011101010011111101011101",
            "1011101000101101101011101",
            "1011101010010110101011101",
            "1000001001011110101000001",
            "1111111010101010101111111",
            "0000000001101110000000000",
            "1001111110000011110010111",
            "0011000111110001110111000",
            "0110101110101001011100011",
            "0110000111011001100001101",
            "1011111010010000001001110",
            "1011110110101111010011000",
            "1100011111000111111001011",
            "1001010101001000010011110",
            "1011001010011101111111101",
            "0000000011110010100010001",
            "1111111011001010101010101",
            "1000001010010111100010000",
            "1011101011110101111111011",
            "1011101011101110011000111",
            "1011101000110101010111011",
            "1000001000111101000001111",
            "1111111011011100100110001"
        ]);
    // version 3
    TestSupport.assertQrMatches(logger, "https://example.com/pass?id=xy&type=member", 6, [
            "11111110101000100100001111111",
            "10000010100111001111001000001",
            "10111010110001110001001011101",
            "10111010010101010100101011101",
            "10111010110110100101001011101",
            "10000010001010100010001000001",
            "11111110101010101010101111111",
            "00000000011011001001100000000",
            "10011111100100111111110010111",
            "01001001110101110101010110110",
            "00010111101010010000010010100",
            "11001101010110101101101001001",
            "01010011110110010000101100001",
            "11100000111101111110101111111",
            "00110111011100010011100110101",
            "00111101010010101000001010101",
            "10101011000111001001100101000",
            "10000001011100010111100010110",
            "11101110011111011101001111001",
            "11100001000111001010010001100",
            "11110011000100110110111111110",
            "00000000100010010100100011000",
            "11111110101101110101101011000",
            "10000010110110010101100010000",
            "10111010101011111001111111010",
            "10111010101110110100000100001",
            "10111010011101010011010110111",
            "10000010001110001010010111101",
            "11111110110010001001111010000"
        ]);
    // version 6
    TestSupport.assertQrMatches(logger, "https://example.com/a/very/long/path/that/pushes/this/into/a/larger/version/abcdefghij/klmnopqrs", 6, [
            "11111110110101101110001001101010001111111",
            "10000010101100101011011001100001101000001",
            "10111010100000101001001111101011101011101",
            "10111010010001111010100011000101101011101",
            "10111010111001110101000001001111001011101",
            "10000010000001000100000100100100001000001",
            "11111110101010101010101010101010101111111",
            "00000000011011111001001111100001000000000",
            "10011111100111111101001010111101010010111",
            "11110001001011000101011100110101000010000",
            "01011011100110101110110100010110011000100",
            "11010100011011001111101000001111111001011",
            "10010110100101101001100000110010101100001",
            "01011101101111100011010010111010001010001",
            "01010111100111111110011000111011111101001",
            "11110100010011010011000010001001110111110",
            "10100011001110011001101101011001110000001",
            "10010101010111010011101000110001110010100",
            "00111111100011000001011110110101000110101",
            "01100000010101000110001111101000011010111",
            "01100111110010110000111000111100101001100",
            "10010001110011111011010100010111010111100",
            "01010010001011011010001100010110001110000",
            "11111101110101010111100100101110010101001",
            "00101111101101111000000110100001101101011",
            "10001100111011010100000100111110101110101",
            "10000011010011010011110000110101110011001",
            "01111101010101010001000110000001000111101",
            "01100111010000010001001111001001110101000",
            "11101000011111011100010100110101100011100",
            "11000111110100110011000010010011010100011",
            "11110001010100011001101101111010001100111",
            "11011010011001110101000100101100111111111",
            "00000000101010001011111100110110100011000",
            "11111110111000111110101101111001101010010",
            "10000010111111100101111100110110100011011",
            "10111010110100001110110101111001111110010",
            "10111010100110111100100100111010100100101",
            "10111010000010111101111010111011010110101",
            "10000010000100010111100010100000001011101",
            "11111110110010100010100111010001110010000"
        ]);
    // version 8
    TestSupport.assertQrMatches(logger, "https://example.com/an/even/longer/path/so/that/the/encoder/has/to/use/two/block/groups/rather/than/one/and/we/exercise/that/too/abcdefghijklmnop", 6, [
            "1111111010111111100010100010101000101100101111111",
            "1000001010011101111010111101100010101111101000001",
            "1011101011001010110010101011010110000101101011101",
            "1011101000111101010011110100100110011101001011101",
            "1011101010010111100101111110011010011100001011101",
            "1000001000100111010010100011110010001010001000001",
            "1111111010101010101010101010101010101010101111111",
            "0000000000110001011001100010110101100000100000000",
            "1001111110000100010111111110110101011011010010111",
            "1000010101111111000111000110111001111110111101000",
            "1110111101001001111010100000010011101101000101011",
            "0110000111010011010011110110011010010001110011111",
            "1101011011100011100010011001101011111110010011010",
            "0111000010110010011110001110111011011011001000010",
            "0110001010101010000000111110000101011010100010011",
            "1101010101110011001010100100000000100101111101101",
            "1000001010110001110100001100011111101101111111110",
            "1111100010010010101101100100101011100100101111110",
            "1110101010001011010010111100010011000001110001101",
            "1110000001011111100011000000110100010111011001000",
            "1011111100001010000110011110110000011000010100001",
            "1001010111100100110011000110011011111111111101000",
            "1001111111001100010100111110110111111000111110101",
            "1110100010010101100111100011010110110100100011110",
            "0001101011010010101101101010111010001110101010011",
            "1001100010100011110011100011111011010010100011100",
            "0110111111110101000100111110000001010110111110011",
            "0000010000001101010010010000010001100011010011101",
            "0101111111001101011010111100010110001101101001101",
            "1111100101011110100110011001111111111000111000010",
            "0111111101100100111100011010110000000101001010101",
            "0011010100100000001001001100100100000011100011011",
            "1011001111101110010110000010111000001101010110001",
            "1111000010010111100111111101011111110111010011110",
            "1000111010110010000101110111110111100000111101001",
            "1100010100000110011110100110001111010111010011101",
            "1100011011100101110100100110101010001011010100001",
            "1100100011101011001010011011111001000010001110000",
            "0100011001100001011010111000010011001011111010011",
            "0111000011001101101110111000001001000001000101110",
            "1110001111000100011100111111001110111011111111100",
            "0000000011001110011100100011001001101101100010100",
            "1111111011001011011001101011100011001100101010001",
            "1000001010110100010000100010110100000001100011011",
            "1011101011010011100000111110110101011010111111001",
            "1011101010010011101011000100011110101110001100111",
            "1011101000010010111110001100010101111100010110110",
            "1000001001100011100001100100010011110110101001111",
            "1111111010010110100101100000110011101001010111001"
        ]);
    return true;
}

//! Mask selection is the one place this encoder deliberately differs from the reference:
//! go-qrcode's penalty rule 1 does not score a run of exactly five, the standard does. Any mask
//! yields a valid symbol because the choice is recorded in the format bits, so the check here is
//! that the chosen mask is legal and that forcing it reproduces the same symbol.
(:test)
function qrChoosesALegalMask(logger as Test.Logger) as Boolean {
    var matrix = Qr.encode("hello");
    var bits = 0;
    for (var i = 0; i < 6; i++) { bits |= matrix.get(8, i) << i; }
    bits |= matrix.get(8, 7) << 6;
    bits |= matrix.get(8, 8) << 7;
    bits |= matrix.get(7, 8) << 8;
    for (var i = 9; i < 15; i++) { bits |= matrix.get(14 - i, 8) << i; }

    var mask = -1;
    for (var m = 0; m < 8; m++) {
        if ((Qr.FORMAT_INFO[m] as Number) == bits) { mask = m; }
    }
    Test.assertMessage(mask >= 0, "the format bits decode to one of the eight masks, got " + bits);

    var forced = Qr.encodeWithMask("hello", mask);
    for (var y = 0; y < matrix.size; y++) {
        for (var x = 0; x < matrix.size; x++) {
            Test.assertEqualMessage(matrix.get(x, y), forced.get(x, y),
                "module " + x + "," + y + " differs when the chosen mask is forced");
        }
    }
    logger.debug("auto-selected mask " + mask + ", format bits round-trip");
    return true;
}

//! Version selection has to follow the payload, and a payload past version 12 must be reported
//! rather than silently truncated.
(:test)
function qrChoosesTheSmallestVersionThatFits(logger as Test.Logger) as Boolean {
    Test.assertEqualMessage(Qr.chooseVersion(10), 1, "10 bytes fit version 1");
    Test.assertEqualMessage(Qr.chooseVersion(14), 1, "14 bytes still fit version 1");
    Test.assertEqualMessage(Qr.chooseVersion(15), 2, "15 bytes need version 2");
    Test.assertEqualMessage(Qr.chooseVersion(287), 12, "287 bytes need version 12");
    Test.assertEqualMessage(Qr.chooseVersion(5000), -1, "an oversized payload is refused");

    var huge = "";
    for (var i = 0; i < 400; i++) { huge += "x"; }
    Test.assertMessage(Qr.encode(huge) == null, "an oversized payload encodes to null");
    Test.assertMessage(Qr.encode("") == null, "empty text encodes to null");
    logger.debug("version selection and refusal behave");
    return true;
}

//! Reed-Solomon is where a subtle arithmetic slip would hide, so check it against a known
//! vector independently of the full pipeline.
(:test)
function reedSolomonMatchesAKnownVector(logger as Test.Logger) as Boolean {
    // The worked example from the QR specification: this data block with 10 EC codewords.
    var data = [0x10, 0x20, 0x0C, 0x56, 0x61, 0x80, 0xEC, 0x11, 0xEC, 0x11,
                0xEC, 0x11, 0xEC, 0x11, 0xEC, 0x11]b;
    var ec = ReedSolomon.encode(data, 10);
    var expected = [0xA5, 0x24, 0xD4, 0xC1, 0xED, 0x36, 0xC7, 0x87, 0x2C, 0x55]b;

    Test.assertEqualMessage(ec.size(), 10, "ten error correction codewords");
    for (var i = 0; i < expected.size(); i++) {
        Test.assertEqualMessage(ec[i], expected[i], "EC codeword " + i);
    }
    logger.debug("Reed-Solomon matches the specification's worked example");
    return true;
}
